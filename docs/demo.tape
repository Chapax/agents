# Enregistrement de l'écran d'installation pour le README.
# vhs pilote un vrai terminal : ce qui sort d'ici est le programme réel,
# pas une maquette.

Output docs/demo.gif

Set FontSize 16
Set Width 1100
Set Height 660
Set Padding 24
Set MarginFill "#0d0e14"
Set BorderRadius 10
Set Theme "Dracula"
Set Shell "bash"
Set TypingSpeed 45ms

Type "cd ~/Projets/outils/agents && ./agents install"
Enter
Sleep 4s
Ctrl+C
Sleep 400ms
